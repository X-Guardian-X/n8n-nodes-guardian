    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst flags = Array.isArray(sd.flags) ? sd.flags : [];\nlet message;\nif (flags.length === 0) {\n  message = 'All documents were extracted cleanly. No missing fields detected — all rows have been written to the sheet.';\n} else {\n  const parts = flags.map((f) => {\n    const lines = [];\n    if (f.missingHeader.length) {\n      lines.push(`Missing header fields: ${f.missingHeader.join(', ')}`);\n    }\n    if (f.badArticles.length) {\n      lines.push(`Article issues: ${f.badArticles.join('; ')}`);\n    }\n    return `• ${f.document}\\n   ${lines.join('\\n   ')}`;\n  });\n  const count = flags.length;\n  message =\n    `${count} document${count === 1 ? '' : 's'} held for review — nothing was written to the sheet for ${count === 1 ? 'it' : 'them'} yet.\\n` +\n    'Once approved in Guardian, the rows are written automatically. Clean documents from this run are already in the sheet.\\n\\n' +\n    'Flagged items:\\n\\n' +\n    parts.join('\\n\\n');\n}\nreturn [{ json: { summaryText: message } }];"
      },
