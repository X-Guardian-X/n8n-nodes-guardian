{
  "name": "n8n-nodes-guardian",
  "version": "1.0.6",
  "description": "n8n community nodes for Guardian Safety Gate — HMAC-signed policy enforcement, atomic execution claims, and automatic human approvals for AI workflows.",
  "keywords": [
    "n8n-community-node-package",
    "guardian",
    "safety",
    "governance",
    "approval",
    "workflow",
    "ai-agent"
  ],
  "license": "MIT",
  "homepage": "https://guardiansafetygate.com",
  "author": {
    "name": "Guardian Safety Gate",
    "email": "support@guardian-safety-gate.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/X-Guardian-X/n8n-nodes-guardian.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run copy:assets",
    "copy:assets": "node -e \"const fs=require('fs');for(const f of['guardian.svg','guardian.dark.svg']){for(const d of['Guardian','GuardianApprovalTrigger'])fs.cpSync('nodes/Guardian/'+f,'dist/nodes/'+d+'/'+f,{recursive:true});fs.cpSync('nodes/Guardian/'+f,'dist/credentials/'+f,{recursive:true})}\"",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "pretest": "npm run build",
    "test": "node test/webhook-contract.test.mjs"
  },
  "files": [
    "dist",
    "contracts",
    "demo/guardian-email-autopilot-workflow.json"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GuardianApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Guardian/Guardian.node.js",
      "dist/nodes/GuardianApprovalTrigger/GuardianApprovalTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.45.4",
    "@types/node": "^26.6.2",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
